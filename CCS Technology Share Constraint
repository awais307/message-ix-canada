
import pandas as pd
import numpy as np
#import pycountry
#from geotext import GeoText
from itertools import product

def expand_grid(dictionary):
   return pd.DataFrame([row for row in product(*dictionary.values())], 
                       columns=dictionary.keys())

def shares(msgSDG, path, nodeName, suffix):

    msgSDG.check_out()   
    # add type_tec for renewable
    type_tec = 'tec_CCS'
    msgSDG.add_set('type_tec', 'tec_CCS')
    
    # defining share for renewable
    shares = 'share_CCS'
    msgSDG.add_set('shares', 'share_CCS')
    
    # including technologies for which shares need to be defined
    tec = ('bio_istig_ccs','coal_adv_ccs','eth_bio_ccs','gas_cc_ccs','h2_bio_ccs','h2_coal_ccs','h2_smr_ccs','igcc_ccs','liq_bio_ccs','meth_coal_ccs','meth_ng_ccs','syn_liq_ccs' )
   
    # defining technologing in cateogry of technologies 
    msgSDG.add_set('cat_tec',pd.DataFrame({'type_tec':'tec_CCS','technology':tec}))

     # Define commodities and levels
    commodities = ['electr', 'lightoil', 'methanol', 'ethanol', 'hydrogen']
    levels = ['secondary', 'primary']
    
    # mapping total share from which share is intended 
    dic = {
            'shares': [shares],
            'node_share': [nodeName],
            'node': [nodeName],
            'type_tec':[str('powerplant')],
            'mode': [str('M1')],
            'commodity': commodities,
            'level': levels
            }
    df = expand_grid(dic)
    msgSDG.add_set('map_shares_commodity_total', df)
        
    # mapping share from total 
    dic = {
            'shares': [shares],
            'node_share': [nodeName],
            'node': [nodeName],
            'type_tec': [type_tec],
            'mode': [str('M1')],
            'commodity': commodities,
            'level': levels
    }
    df = expand_grid(dic)
    msgSDG.add_set('map_shares_commodity_share', df)
    
    # Fetching the index names of a parameter
    msgSDG.idx_names("share_commodity_lo")
 
    # Adding data to the parameter
    df = pd.DataFrame(
    {
        "shares": shares,
        "node_share": [nodeName],
        "year_act": [str('2020')], #change for years we want?
        "time": "year",
        "value": [0.5], #confiure with what percentage share we want our tecs to be
        "unit": "-",
    }
    )
    msgSDG.add_par("share_commodity_lo", df)

    msgSDG.commit('CCS shares defined')