def shares_h2_rc(msgSDG, path, nodeName, suffix):

    msgSDG.check_out()   
    # add type_tec
    type_tec = 'h2_residential_commercial'
    msgSDG.add_set('type_tec', 'h2_residential_commercial')
    
    # defining share
    shares = 'share_h2_rc'
    msgSDG.add_set('shares', 'share_h2_rc')
    
    # including technologies for which shares need to be defined
    tec = ('h2_rc','h2_fc_RC')
   
    # defining technologing in cateogry of technologies 
    msgSDG.add_set('cat_tec',pd.DataFrame({'type_tec':'h2_residential_commercial','technology':tec}))

      # Define commodities and levels
    commodities = ['rc_spec', 'rc_therm']
    levels = ['useful']

        # mapping share from total 
    dic = {
            'shares': [shares],
            'node_share': [nodeName],
            'node': [nodeName],
            'type_tec': [type_tec],
            'mode': [str('M1')],
            'commodity': commodities,
            'level': levels
    }
    df = expand_grid(dic)
    msgSDG.add_set('map_shares_commodity_share', df)

    type_tec = 'residential_enduse'
    msgSDG.add_set('type_tec', 'residential_enduse')
    
    # including technologies for which shares need to be defined
    tec = ('h2_fc_RC','sp_el_RC','solar_rc','biomass_rc','coal_rc','elec_rc','eth_rc','foil_rc','h2_rc','heat_rc','hp_el_rc','hp_gas_rc','loil_rc','loil_rc','meth_rc','RCtherm_1','RCtherm_2','RCtherm_3','RCtherm_4','RCtherm_5')
           
    # defining technologing in cateogry of technologies 
    msgSDG.add_set('cat_tec',pd.DataFrame({'type_tec':'residential_enduse','technology':tec}))

    
    # mapping total share from which share is intended 
    dic = {
            'shares': [shares],
            'node_share': [nodeName],
            'node': [nodeName],
            'type_tec':[type_tec],
            'mode': [str('M1')],
            'commodity': commodities,
            'level': levels
            }
    df = expand_grid(dic)
    msgSDG.add_set('map_shares_commodity_total', df)

    msgSDG.commit('h2_rc share mapping')

