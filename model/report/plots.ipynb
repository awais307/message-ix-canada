    "    ('Residents & Commercial', 'Oil', 'Final Energy|Oil|RC'),\n",
    "    ('Residents & Commercial', 'Refined Liquid', 'Final Energy|Refined Liquid|RC'),\n",
    "    ('Residents & Commercial', 'Electricity', 'Final Energy|Electricity|RC'),\n",
    "    ('Residents & Commercial', 'Hydrogen', 'Final Energy|Hydrogen|RC'),\n",
    "    ('Residents & Commercial', 'Final Energy By Sector', 'Final Energy|RC'),\n",
    "    ('Transport', 'Coal', 'Final Energy|coal|coal_trp|M1'),\n",
    "    ('Transport', 'Gas', 'Final Energy|gas|gas_trp|M1'),\n",
    "    ('Transport', 'Oil', 'Final Energy|Oil|Transport'),\n",
    "    ('Transport', 'Refined Liquid', 'Final Energy|Refined Liquid|Transport'),\n",
    "    ('Transport', 'Electricity', 'Final Energy|Electricity|Transport'),\n",
    "    ('Transport', 'Hydrogen', 'Final Energy|Hydrogen|Transport'),\n",
    "    ('Transport', 'Final Energy By Sector', 'Final Energy|Transport'),\n",
    "    ('Feedstocks (Non-Energy)', 'Coal', 'Final Energy|coal|coal_fs|M1'),\n",
    "    ('Feedstocks (Non-Energy)', 'Gas', 'Final Energy|gas|gas_fs|M1'),\n",
    "    ('Feedstocks (Non-Energy)', 'Oil', 'Final Energy|Oil|FS'),\n",
    "    ('Feedstocks (Non-Energy)', 'Refined Liquid', 'Final Energy|Refined Liquid|FS'),\n",
    "    ('Feedstocks (Non-Energy)', 'Final Energy By Sector', 'Final Energy|FS'),\n",
    "    ('Final Energy By Fuel', 'Coal', 'Final Energy|coal|coal_fs|M1'),\n",
    "    ('Final Energy By Fuel', 'Gas', 'Final Energy|gas|gas_fs|M1'),\n",
    "    ('Final Energy By Fuel', 'Oil', 'Final Energy|Oil|FS'),\n",
    "    ('Final Energy By Fuel', 'Refined Liquid', 'Final Energy|Refined Liquid|FS'),\n",
    "    ('Final Energy By Fuel', 'Electricity', 'Final Energy|Electricity'),\n",
    "    ('Final Energy By Fuel', 'Hydrogen', 'Final Energy|Hydrogen'),\n",
    "    ('Final Energy By Fuel', 'Final Energy By Sector', 'Final Energy'),\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "def plot_grid(df_final, gdf, vars):\n",
    "    df = df_final.timeseries().reset_index()\n",
    "\n",
    "    # Align the region names by removing spaces in the CSV file region column\n",
    "    df['region'] = df['region'].str.replace(' ', '')\n",
    "    gdf['PRENAME'] = gdf['PRENAME'].str.replace(' ', '')\n",
    "\n",
    "    # Calculate the number of rows and columns for the subplot grid\n",
    "    n_vars = len(vars)\n",
    "    n_cols = 5  # Number of columns in the grid\n",
    "    n_rows = math.ceil(n_vars / n_cols)\n",
    "\n",
    "    df.rename(columns={2050: 'value'}, inplace=True)\n",
    "\n",
    "    # Merge the electricity generation data with the GeoDataFrame\n",
    "    gdf_merged = gdf.merge(df[['region', 'value', 'variable']], left_on='PRENAME', right_on='region', how='left')\n",
    "\n",
    "    # Create a colormap for value differences\n",
    "    norm = plt.Normalize(vmin=gdf_merged['value'].min(), vmax=gdf_merged['value'].max())\n",
    "\n",
    "    # Create a grid of plots\n",
    "    fig, axes = plt.subplots(n_rows, n_cols, figsize=(5 * n_cols, 5 * n_rows))\n",
    "\n",
    "    for i, (index, column, variable) in enumerate(vars):\n",
    "        print('Rendering:', index, column, variable, '...', i + 1, 'of', len(vars))\n",
    "        # Filter the data for the specified variable\n",
    "        gdf_plot = gdf_merged[gdf_merged['variable'] == variable]\n",
    "\n",
    "\n",
    "        # Plot the map with province polygons colored by electricity generation values for the chosen year\n",
    "        ax = axes[i // n_cols, i % n_cols]\n",
    "        gdf_plot.plot(column='value', cmap='viridis', linewidth=0.8, ax=ax, edgecolor='black', legend=False, norm=norm)\n",
    "\n",
    "        # # Add a colorbar for the scale\n",
    "        # sm = plt.cm.ScalarMappable(norm=norm)\n",
    "        # sm.set_array([])  # We don't need an actual array here\n",
    "        # # We don't need an actual array here\n",
    "\n",
    "        # save subplot to file\n",
    "        # Remove axis for the subplot\n",
    "        ax.set_axis_off()\n",
    "\n",
    "        # save subplot to file\n",
    "        plt.savefig(f'output_{index}_{column}.png')\n",
    "\n",
    "    # Remove empty subplots\n",
    "    for j in range(i + 1, n_rows * n_cols):\n",
    "        fig.delaxes(axes[j // n_cols, j % n_cols])\n",
    "\n",
    "    # Add a global colorbar for the entire figure\n",
    "    cbar_ax = fig.add_axes([0.15, 0.05, 0.7, 0.02])  # Adjust the position and size as needed\n",
    "    sm = plt.cm.ScalarMappable(norm=norm, cmap='viridis')\n",
    "    fig.colorbar(sm, cax=cbar_ax, orientation='horizontal', label='Value')\n",
    "    for j in range(i + 1, n_rows * n_cols):\n",
    "        fig.delaxes(axes[j // n_cols, j % n_cols])\n",
    "\n",
    "    # save subplot to file\n",
    "\n",
    "    # Show the plot\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    # Save the plot to a file\n",
    "    fig.savefig('output.png')\n",
    "\n",
    "plot_grid(df_final, gdf, vars)\n"
   ]
  },
