    "import yaml\n",
    "import random\n",
    "\n",
    "def read_yaml(file_path):\n",
    "    with open(file_path, 'r') as file:\n",
    "        data = yaml.safe_load(file)\n",
    "    return data\n",
    "\n",
    "def write_yaml(file_path, data):\n",
    "    with open(file_path, 'w') as file:\n",
    "        yaml.dump(data, file, default_flow_style=False)\n",
    "\n",
    "def random_color():\n",
    "    return \"#{:06x}\".format(random.randint(0, 0xFFFFFF))\n",
    "\n",
    "def process_yaml(data):\n",
    "    new_data = {}\n",
    "    for category, items in data.items():\n",
    "        group_color = random_color()\n",
    "        for item in items:\n",
    "            item_name = item\n",
    "            new_data[item_name] = {\n",
    "                \"color\": random_color(),\n",
    "                \"group\": category,\n",
    "                \"group_color\": group_color,\n",
    "                \"name\": item_name\n",
    "            }\n",
    "    return new_data\n",
    "\n",
    "def main():\n",
    "    input_file = '/Users/muhammadawais/Documents/GitHub/message-ix-canada/model/output_mapping.yaml'  # Replace with your input YAML file path\n",
    "    output_file = 'output_mapping_idea.yaml'  # Output file path\n",
    "    data = read_yaml(input_file)\n",
    "    processed_data = process_yaml(data)\n",
    "    write_yaml(output_file, processed_data)\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
  },
