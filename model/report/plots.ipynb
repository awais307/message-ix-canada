    "\n",
    "df = df_final.timeseries().reset_index()\n",
    "# Filter the data for electricity generation values\n",
    "df_plot = df[df['variable'] == 'Final Energy|coal|coal_fs|M1']\n",
    "df_plot.rename(columns={2050: 'value'}, inplace=True)\n",
    "df_plot['value'] =df_plot['value'] *8.76*3.6\n",
    "# Align the region names by removing spaces in the CSV file region column\n",
    "df_plot['region'] = df_plot['region'].str.replace(' ', '')\n",
    "\n",
    "# Align with the shapefile's province names (PRENAME)\n",
    "gdf['PRENAME'] = gdf['PRENAME'].str.replace(' ', '')\n",
    "\n",
    "# Merge the electricity generation data with the GeoDataFrame\n",
    "gdf = gdf.merge(df_plot[['region', 'value']], left_on='PRENAME', right_on='region', how='left')\n",
    "\n",
    "# Create a colormap for value differences\n",
    "norm = plt.Normalize(vmin=gdf['value'].min(), vmax=gdf['value'].max())\n",
    "cmap = cm.get_cmap('viridis')\n",
    "\n",
    "# Plot the map with province polygons colored by electricity generation values for the chosen year\n",
    "fig, ax = plt.subplots(1, 1, figsize=(15, 15))\n",
    "gdf.plot(column='value', cmap='viridis', linewidth=0.8, ax=ax, edgecolor='black', legend=True)\n",
    "\n",
    "# Add a colorbar for the scale\n",
    "sm = plt.cm.ScalarMappable(cmap=cmap, norm=norm)\n",
    "sm.set_array([])  # We don't need an actual array here\n",
    "fig.colorbar(sm, ax=ax, orientation='horizontal', label=f'Electricity Generation Value for 2050')\n",
    "ax.set_axis_off()\n",
    "# Show the plot\n",
    "plt.show()"
   ]
  },
